# Reverse proxy and TLS termination for the staging stack.
#
# Replaces nginx. Caddy obtains a real, browser-trusted certificate from DHBW's
# ACME endpoint (HARICA) instead of the self-signed one the Ansible playbook
# generated, which removes the cert step from the playbook, the nginx/certs
# volume, and the NGINX_CONFIG_HASH label trick.
#
# The three settings below come from .env, like everything else the stack is
# configured with. APP_HOSTNAME must be a DNS name that resolves to this VM -
# ACME issues certificates for domains, never for bare IP addresses.
#
# Running this locally: point APP_HOSTNAME at localhost, or add `tls internal`
# inside the site block. Caddy then signs with its own CA and skips ACME
# entirely, so no public DNS record is needed.
{
	acme_ca {$ACME_CA_URL}
	email {$ACME_EMAIL}
}

{$APP_HOSTNAME} {
	# handle_path strips the prefix before proxying, which is what nginx's
	# `rewrite ^/api/(.*) /$1 break` did.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Keycloak 17+ serves at the root rather than under /auth, so the top-level
	# paths it owns have to be routed before the SPA catch-all below swallows
	# them. reverse_proxy sets X-Forwarded-Proto itself, which is what
	# KC_PROXY=edge relies on to build HTTPS redirect URIs.
	@keycloak path /realms/* /resources/* /admin/* /js/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy frontend:8080
	}

	# nginx capped uploads at 50m via client_max_body_size; Caddy has no limit
	# by default, so it is restated here to keep the behaviour unchanged.
	request_body {
		max_size 50MB
	}
}
